{
  "name": "easylist",
  "version": "1.0.0",
  "description": "EasyList offline desktop app",
  "main": "electron/main.js",
  "type": "commonjs",
  "author": "You",
  "private": false,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder --publish never",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "build": {
    "appId": "com.easylist.app",
    "productName": "EasyList",
    "asar": true,
    "extraMetadata": {
      "env": {
        "NODE_ENV": "production"
      }
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^25.9.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.6",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "antd": "^5.27.4",
    "i18next": "^25.6.0",
    "lodash": "^4.17.21",
    "lowdb": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "sqlite3": "^5.1.7",
    "uuid": "^8.3.2"
  }
}
